COMPOSE_PROJECT_NAME=longhaul

# --- LOCKED ports (never change without the owner) ---
POSTGRES_PORT=5438
API_PORT=8008
UI_PORT=9008
UI_PORT_FALLBACK=3008

# --- Proposed ports (verified free 2026-07-20) ---
REDIS_PORT=6438
MINIO_API_PORT=9018
MINIO_CONSOLE_PORT=9019
MAILPIT_SMTP_PORT=1038
MAILPIT_UI_PORT=8038

# --- Postgres ---
POSTGRES_DB=longhaul
POSTGRES_USER=longhaul
POSTGRES_PASSWORD=longhaul_dev_only

# --- MinIO (dev credentials only; real keys live outside VCS) ---
MINIO_ROOT_USER=longhaul
MINIO_ROOT_PASSWORD=longhaul_dev_only

# --- App ---
ENVIRONMENT=dev
API_HOST=postgres
REDIS_HOST=redis

# M1 live map tiles — Mapbox PUBLIC token (pk.*), URL-restricted. Real value in infra/.env only.
MAPBOX_TOKEN=

# F9 AI gateway — Anthropic API key (sk-ant-...) activates real Claude in M4/M9/M11.
# Empty -> deterministic FakeModelProvider (canned output). Real value in infra/.env only.
ANTHROPIC_API_KEY=
F9_MODEL=claude-haiku-4-5-20251001

# F1 authority verification — FMCSA QCMobile webKey activates real MC#/DOT lookup.
# Empty -> deterministic FakeAuthorityVerifier. Free key at mobile.fmcsa.dot.gov.
FMCSA_WEBKEY=

# F9 embeddings — Voyage AI key (pa-...) activates real vectors for M2 semantic
# search. Empty -> deterministic FakeModelProvider embedding. Key in infra/.env only.
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3.5

# Web Push / VAPID (design-prd §13.1) — a P0 to a phone in a pocket. BOTH keys present
# activates real delivery; empty -> the recording gateway, so a laptop with no keypair
# still exercises every tiering decision F8 makes.
#
# SELF-GENERATED, not issued by anyone — this is why push needs no vendor account:
#     make vapid-keys
# The PRIVATE key is a secret and lives in infra/.env only (rule 9). The PUBLIC key is
# public by definition: the browser needs it to build a subscription.
#
# Rotating the pair INVALIDATES every stored subscription — browsers subscribe against
# a specific application server key — so every driver must re-enable alerts. Rotate
# only on a compromise, and expect the push_subscription table to drain.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:ops@haulmeter.online

# M7 fuel baseline — EIA API key activates real weekly regional diesel averages
# (`make ingest-eia`, M1-FR5). Empty -> the map falls back to crowd-reported prices
# only. Free key at https://www.eia.gov/opendata/ ("Register"). Key in infra/.env only.
EIA_API_KEY=

# Demo seed (PRD §12) — OFF by default. Real POI data comes from the F2 ingestion
# pipeline (NTAD/TPIMS/OSM via `make ingest-*`), not this seed. Set DEV_SEED=1 (or
# use `make seed`) to plant the Dallas demo cluster for a rich local browser view.
DEV_SEED=
# Optional: plant a few obviously-fake "DEV —" facilities (shipper, truck stop,
# bookable yard) around any point so geofencing + the detention clock can be
# field-tested anywhere. Format: lat,lon (e.g. 41.8781,-87.6298).
DEV_SEED_ORIGIN=

# AI-CONTEXT: where a COUNTERPARTY reaches this platform from their inbox. A broker
# opening a detention notice is outside every session and origin we control, so the
# relative "/pack/s/<token>" the client makes absolute is useless in an email.
# Empty means "we cannot address ourselves", and the notice then says the evidence is
# available on request rather than printing a link that goes nowhere.
#
# SET IN DEV, deliberately, and this is not cosmetic: a Stop Packet is REFUSED outright
# without it (503 — "a packet with no link reaches nobody"), because for a handoff the
# link IS the document. Left empty, DRIVE.md's J7-AP cannot be completed at all: the
# card appears, the sheet opens, Send says "Not sent" and the journey stops one step
# short of the only question it exists to answer — is the driver's BOL in the PDF.
# Measured on a real walk, 2026-08-02. The local API serves the share link, so pointing
# at it makes the Mailpit link openable from the host.
PUBLIC_BASE_URL=http://localhost:8008

# AI-CONTEXT: the COUNTERPARTY email transport (§23 entry 122). Until 2026-08-02 there
# was no SMTP gateway in the codebase at all — every send site passed a recording
# gateway, so the F8 rows said a notice was sent and nothing ever left the box. Mailpit
# had been in this file since session 0 and had received zero messages.
#
# The dev defaults ARE the compose service; Mailpit binds MAILPIT_SMTP_PORT inside the
# network as well as on the host, so `mailpit:1038` resolves as written and needs no
# credentials. BLANK SMTP_HOST to switch email off — the gateway then falls back to
# recording rather than pretending (the test suite does exactly this).
#
# Mailpit stays the committed default because a fresh clone has no credentials and must
# still be able to send. The owner's real provider is GMAIL (decided 2026-08-04); its
# block goes in this file's untracked twin, never here:
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587           <- 587 ONLY. The gateway opens smtplib.SMTP and then calls
#                              starttls(); 465 is implicit SSL and would need SMTP_SSL,
#                              which is not written. 465 hangs until the 10 s timeout and
#                              returns smtp-failed-SMTPServerDisconnected.
#   SMTP_STARTTLS=true
#   SMTP_USERNAME=<the full gmail address>
#   SMTP_PASSWORD=<a 16-char APP PASSWORD, not the account password — Google refuses
#                  account passwords over SMTP, and 2-Step Verification must be on
#                  before the App Password screen exists at all>
#   SMTP_FROM=<the same gmail address>
#
# SMTP_FROM MUST equal SMTP_USERNAME on Gmail. Google rewrites the From header to the
# authenticated account unless the address is a verified "Send mail as" alias, so a
# mismatched SMTP_FROM does not fail — it silently ships a From line nobody chose, and
# the F8 row records a success. Free Gmail also caps around 500 recipients/day.
SMTP_HOST=mailpit
SMTP_PORT=1038
SMTP_FROM=paperwork@haulmeter.online
# a real provider needs these; Mailpit needs neither. STARTTLS on for anything real.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
